name: Build Jarvis Desktop

on:
  push:
    branches: [ "main", "develop" ]
  pull_request:
    branches: [ "main" ]

jobs:
  build-desktop:
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout du code
      uses: actions/checkout@v4

    - name: Configuration de Java JDK 17
      uses: actions/setup-java@v4
      with:
        java-version: '17'
        distribution: 'zulu'
        cache: 'gradle'

    - name: Accorder les permissions d'exécution à Gradle
      run: chmod +x gradlew

    - name: Compiler le package Desktop
      run: ./gradlew :desktop:packageDistributionForCurrentOS

    - name: Téléverser l'exécutable généré
      uses: actions/upload-artifact@v4
      with:
        name: jarvis-desktop-app
        path: desktop/build/compose/binaries/main/
